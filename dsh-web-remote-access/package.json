{
  "name": "@studyzy/dsh-web-remote-access",
  "description": "Out-of-tree dsh web-profile bundle: enables --host 0.0.0.0 for direct remote Web access with NO access token (dev/worker instances on any port are never intercepted). Forks @deepseek-ai/dsh-host-webserver and @deepseek-ai/dsh-web-app/startup, plus a remote-access settings page with a scan-to-open QR.",
  "version": "1.0.1",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "harness",
    "plugin",
    "bundle",
    "web",
    "remote-access"
  ],
  "license": "MIT",
  "author": {
    "name": "studyzy",
    "email": "studyzy@163.com",
    "url": "https://github.com/studyzy"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studyzy/dsh-web-remote-access.git"
  },
  "homepage": "https://github.com/studyzy/dsh-web-remote-access#readme",
  "bugs": {
    "url": "https://github.com/studyzy/dsh-web-remote-access/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./startup": {
      "default": "./lib/startup.js"
    },
    "./webserver": {
      "default": "./lib/webserver.js"
    },
    "./url": {
      "default": "./lib/url.js"
    },
    "./polyfill": {
      "default": "./lib/polyfill.js"
    },
    "./settings-api": {
      "default": "./lib/settings-api.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
